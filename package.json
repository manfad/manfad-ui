{
  "name": "@yf/ui",
  "version": "0.1.0",
  "description": "Shared admin UI kit: shadcn-style Vue components on UnoCSS, compatible with old browsers (no oklch, Chrome 109+)",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.mjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@iconify-json/lucide": "^1.2.68",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^2.6.0",
    "unocss-preset-animations": "^1.1.1",
    "unocss-preset-shadcn": "^1.0.1"
  },
  "peerDependencies": {
    "unocss": ">=66.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@unocss/reset": "^66.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "^5.7.2",
    "unocss": "^66.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
